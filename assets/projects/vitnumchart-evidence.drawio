" value="&lt;b&gt;25–48&lt;/b&gt;" style="text;strokeColor=none;fillColor=none;html=1;whiteSpace=wrap;fontFamily=Helvetica;fontSize=44;fontColor=#B02F2A;fontStyle=0;align=left;verticalAlign=middle;spacing=0;spacingLeft=0;spacingRight=0;" vertex="1" parent="1"><mxGeometry x="866" y="614" width="190" height="70" as="geometry"/></mxCell><mxCell id="n113" value="&lt;span style=&quot;color:#5E6577;font-size:11px&quot;&gt;public-test items&lt;/span&gt;" style="text;strokeColor=none;fillColor=none;html=1;whiteSpace=wrap;fontFamily=Helvetica;fontSize=11;fontColor=#1F2430;fontStyle=0;align=left;verticalAlign=middle;spacing=0;spacingLeft=0;spacingRight=0;" vertex="1" parent="1"><mxGeometry x="866" y="678" width="190" height="36" as="geometry"/></mxCell><mxCell id="n114" value="structural PA, which ignores argument strings, overestimated the official score by 25 to 48 items on the public test&lt;br&gt;and misled several early decisions.&lt;br&gt;&lt;br&gt;Later comparisons use grounded PA, which matches the official metric." style="text;strokeColor=none;fillColor=none;html=1;whiteSpace=wrap;fontFamily=Helvetica;fontSize=11.5;fontColor=#3A4152;fontStyle=0;align=left;verticalAlign=top;spacing=0;spacingLeft=0;spacingRight=0;" vertex="1" parent="1"><mxGeometry x="1070" y="606" width="570" height="128" as="geometry"/></mxCell><mxCell id="n115" value="" style="rounded=1;arcSize=3.6;fillColor=#FBFBFD;strokeColor=#D3D8E2;strokeWidth=1.2;html=1;whiteSpace=wrap;fontFamily=Helvetica;fontSize=13;fontColor=#1F2430;fontStyle=0;align=center;verticalAlign=middle;spacing=0;spacingLeft=0;spacingRight=0;" vertex="1" parent="1"><mxGeometry x="20" y="780" width="1660" height="390" as="geometry"/></mxCell><mxCell id="n116" value="(c)" style="rounded=1;arcSize=25.0;fillColor=#217A4B;strokeColor=#217A4B;strokeWidth=1.5;html=1;whiteSpace=wrap;fontFamily=Helvetica;fontSize=12.5;fontColor=#FFFFFF;fontStyle=1;align=center;verticalAlign=middle;spacing=0;spacingLeft=0;spacingRight=0;" vertex="1" parent="1"