="14" as="geometry"/></mxCell><mxCell id="n132" value="clear loss: stopped, no confirmation seeds" style="text;strokeColor=none;fillColor=none;html=1;whiteSpace=wrap;fontFamily=Helvetica;fontSize=10.5;fontColor=#3A4152;fontStyle=0;align=left;verticalAlign=middle;spacing=0;spacingLeft=0;spacingRight=0;" vertex="1" parent="1"><mxGeometry x="1200" y="541" width="450" height="24" as="geometry"/></mxCell><mxCell id="n133" value="Every comparison is paired on the same 2,000 frozen&lt;br&gt;validation tracks (McNemar test). Single seed unless&lt;br&gt;stated; a change under 1 point never promotes a&lt;br&gt;model by itself." style="text;strokeColor=none;fillColor=none;html=1;whiteSpace=wrap;fontFamily=Helvetica;fontSize=10.5;fontColor=#3A4152;fontStyle=0;align=left;verticalAlign=top;spacing=0;spacingLeft=0;spacingRight=0;" vertex="1" parent="1"><mxGeometry x="1176" y="584" width="470" height="70" as="geometry"/></mxCell><mxCell id="n134" value="&lt;b&gt;Also stopped before training:&lt;/b&gt; real-LR character&lt;br&gt;recombination. Splicing two tracks of the same plate&lt;br&gt;already dropped accuracy from about 98 % to 83 %,&lt;br&gt;so the synthetic plates were not valid training data." style="text;strokeColor=none;fillColor=none;html=1;whiteSpace=wrap;fontFamily=Helvetica;fontSize=10.5;fontColor=#3A4152;fontStyle=0;align=left;verticalAlign=top;spacing=0;spacingLeft=0;spacingRight=0;" vertex="1" parent="1"><mxGeometry x="1176" y="676" width="470" height="100" as="geometry"/></mxCell><mxCell id="n135" value="" style="rounded=1;arcSize=3.3;fillColor=#FBFBFD;strokeColor=#D3D8E2;strokeWidth=1.2;html=1;whiteSpace=wrap;fontFamily=Helvetica;fontSize=13;fontColor=#1F2430;fontStyle=0;align=center;verticalAlign=middle;spacing=0;spacingLeft=0;spacingRight=0;" vertex="1" parent="1"><mxGeometry x="20" y="840" width="1660" height="430" as="geometry"/></mxCell><mxCell id="n136" value="(c)" style="rounded=1;arcSize=25.0;fillColor=#A8740A;strokeColor=#A8740A;strokeWidth=1.5;html=1;whi